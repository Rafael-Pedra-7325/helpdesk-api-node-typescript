{
  "name": "helpdesk-api-node-typescript",
  "version": "1.0.0",
  "description": "API RESTful para gestão de chamados de TI desenvolvida com Node.js e TypeScript.",
  "main": "src/server.ts",
  "scripts": {
    "start": "ts-node src/server.ts",
    "build": "tsc",
    "dev": "ts-node-dev --respawn src/server.ts"
